<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PhotoGrouper.Domain\PhotoGrouper.Domain.csproj" />
    <ProjectReference Include="..\PhotoGrouper.Application\PhotoGrouper.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AnyCPU rather than the x64 build: the same version, carrying native libraries for Windows,
         Linux and macOS in one package, so HEIC decoding needs no per-platform reference. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
  </ItemGroup>

  <!-- OpenCV's managed wrapper is portable; its native library is not, so the runtime package is
       chosen for the platform being built on. The version must match the managed package exactly,
       or the wrapper loads a library whose exports it does not recognise. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
  </ItemGroup>

  <!-- Both macOS architectures are referenced together; the correct one is selected by runtime
       identifier when the application is published or run. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="OpenCvSharp4.runtime.osx.arm64" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.x64" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>
