<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One place for every colour and control style in the application.

         Defined as resources rather than set on individual controls so that the palette is a
         single decision rather than a habit repeated across a dozen files. Anything hard-coded in
         a view is a colour that will be missed the next time the theme changes. -->

    <Styles.Resources>
        <!-- Depth is carried by three background layers rather than by borders: the window sits
             furthest back, panels above it, cards above those. Surfaces then read as stacked
             without needing an outline around everything. -->
        <Color x:Key="SurfaceDeepColor">#070A12</Color>
        <Color x:Key="SurfacePanelColor">#0E1421</Color>
        <Color x:Key="SurfaceCardColor">#141C2C</Color>
        <Color x:Key="SurfaceRaisedColor">#1B2438</Color>

        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="AccentSecondaryColor">#7C5CFF</Color>
        <Color x:Key="SuccessColor">#3DDC97</Color>
        <Color x:Key="WarningColor">#FFB454</Color>
        <Color x:Key="DangerColor">#FF5C7A</Color>

        <Color x:Key="TextPrimaryColor">#EAF0FA</Color>
        <Color x:Key="TextMutedColor">#8792A8</Color>
        <Color x:Key="BorderColor">#1E2942</Color>

        <SolidColorBrush x:Key="SurfaceDeep" Color="{StaticResource SurfaceDeepColor}" />
        <SolidColorBrush x:Key="SurfacePanel" Color="{StaticResource SurfacePanelColor}" />
        <SolidColorBrush x:Key="SurfaceCard" Color="{StaticResource SurfaceCardColor}" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentSecondary" Color="{StaticResource AccentSecondaryColor}" />
        <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderColor}" />

        <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentColor}" Opacity="0.14" />
        <SolidColorBrush x:Key="AccentEdge" Color="{StaticResource AccentColor}" Opacity="0.55" />

        <!-- Reserved for the one primary action on a screen. Reaching for it more than once per
             screen is what turns an accent into wallpaper. -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
            <GradientStop Color="{StaticResource AccentSecondaryColor}" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#0E1421" Offset="0" />
            <GradientStop Color="#141C2C" Offset="0.5" />
            <GradientStop Color="#0E1421" Offset="1" />
        </LinearGradientBrush>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource SurfaceDeep}" />
        <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Letter-spaced small capitals for section labels: legible at a glance without competing
         with the content beneath them. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="LetterSpacing" Value="1.4" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentDim}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentEdge}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- The primary action. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Foreground" Value="#05080F" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="TextElement.Foreground" Value="#05080F" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <!-- A two-state switch that reads as part of this application.
         Left to the default, the checked state paints itself in the system accent colour, which is
         whatever the user chose in Windows personalisation. On a machine set to red that reads as a
         warning rather than as a selection. Scoped to a class rather than to every ToggleButton, so
         nothing a control template builds out of one is restyled by accident. -->
    <Style Selector="ToggleButton.chip">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
    </Style>

    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="TextElement.Foreground" Value="#05080F" />
    </Style>

    <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="TextElement.Foreground" Value="#05080F" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Border.tile:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource AccentEdge}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceDeep}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="5" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
