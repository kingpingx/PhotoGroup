<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoGrouper.App.ViewModels"
             xmlns:views="using:PhotoGrouper.App.Views"
             xmlns:photos="using:PhotoGrouper.Domain.Photos"
             xmlns:ports="using:PhotoGrouper.Application.Ports"
             x:Class="PhotoGrouper.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Margin="28,22">

            <!-- The two actions of this stage, presented in the order they happen and separated by
                 an arrow. Ordinary toolbar buttons sitting side by side give no hint that scanning
                 must come before detecting, which is the single most common thing to get wrong on
                 a first run. -->
            <Border Grid.Row="0" Classes="card" Padding="20,16" Margin="0,0,0,18">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="STEP ONE" Classes="label" />
                        <Button Content="Add folder" Click="OnAddFolderClick" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="→" Classes="muted" FontSize="18"
                               VerticalAlignment="Bottom" Margin="16,0,16,8" />

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="STEP TWO" Classes="label" />
                        <Button Content="Scan for photos" Command="{Binding ScanCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="→" Classes="muted" FontSize="18"
                               VerticalAlignment="Bottom" Margin="16,0,16,8" />

                    <StackPanel Grid.Column="4" Spacing="6">
                        <TextBlock Text="STEP THREE" Classes="label" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Find faces" Classes="primary"
                                    Command="{Binding DetectCommand}" />
                            <ComboBox ItemsSource="{Binding Detectors}"
                                      SelectedItem="{Binding SelectedDetector}"
                                      MinWidth="145" VerticalAlignment="Center"
                                      ToolTip.Tip="{Binding SelectedDetector.Notes}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="ports:ProviderInfo">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Spacing="6" Margin="34,0,0,0"
                                VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <!-- Not a fourth step. Scanning and detecting have to happen in order and
                             on a first run; this is maintenance, done when a library has grown
                             untidy rather than as part of setting one up. -->
                        <TextBlock Text="TIDY UP" Classes="label" />
                        <Button Content="Find duplicates"
                                Command="{Binding Duplicates.OpenCommand}"
                                IsEnabled="{Binding PhotoCount}"
                                ToolTip.Tip="Find photos that are the same picture, such as a burst of camera shots" />
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="20"
                                VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding PhotoCount, StringFormat='{}{0:N0}'}"
                                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Text="PHOTOS" Classes="label" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding FaceCount, StringFormat='{}{0:N0}'}"
                                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Accent}" />
                            <TextBlock Text="FACES" Classes="label" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Content="Stop" Classes="danger" Command="{Binding CancelScanCommand}"
                                IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
                        <Button Content="Clear library" Classes="ghost" VerticalAlignment="Center"
                                Click="OnClearLibraryClick"
                                IsVisible="{Binding PhotoCount}"
                                ToolTip.Tip="Opens Settings, which shows exactly what will be removed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="Auto,*">

                <ItemsControl Grid.Row="0" ItemsSource="{Binding ScanRoots}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="photos:ScanRoot">
                            <Border Background="{StaticResource SurfaceRaised}"
                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="20" Padding="14,6" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Path}" VerticalAlignment="Center" FontSize="12" />
                                    <Button Content="✕" Padding="6,0" FontSize="11" Classes="ghost"
                                            Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).RemoveScanRootCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Shown only when there is genuinely nothing yet, so a first run says what to do
                     rather than presenting an unexplained empty rectangle. -->
                <Border Grid.Row="1" Classes="card" Padding="40"
                        IsVisible="{Binding !PhotoCount}"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="◈" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Accent}" />
                        <TextBlock Text="No photos yet" Classes="heading" HorizontalAlignment="Center" />
                        <TextBlock Classes="muted" HorizontalAlignment="Center" MaxWidth="330"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Add a folder, scan it, then find faces. Nothing is copied or moved; your files stay exactly where they are." />
                    </StackPanel>
                </Border>

                <!-- ItemsRepeater with a UniformGridLayout virtualises its containers, so only the
                     tiles actually on screen exist as controls. A WrapPanel would realise all of
                     them, which is fine for a hundred photos and fatal for fifty thousand. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding PhotoCount}">
                    <ItemsRepeater ItemsSource="{Binding Photos}"
                                   ElementPrepared="OnTilePrepared"
                                   ElementClearing="OnTileClearing">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout ItemsStretch="None"
                                               MinItemWidth="184" MinItemHeight="184"
                                               MinColumnSpacing="12" MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoTileViewModel">
                                <Border Width="184" Height="184" Classes="tile"
                                        ToolTip.Tip="{Binding Tooltip}"
                                        Cursor="Hand" ClipToBounds="True"
                                        PointerPressed="OnTilePressed">
                                    <Grid RowDefinitions="*,Auto">
                                        <Image Grid.Row="0" Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill" Margin="5,5,5,0" />
                                        <Border Grid.Row="1" Padding="9,6">
                                            <TextBlock Text="{Binding FileName}" Classes="muted"
                                                       FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Classes="card" Padding="16,12" Margin="0,16,0,0">
                <StackPanel Spacing="8">
                    <ProgressBar IsVisible="{Binding IsScanning}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Value="{Binding ProgressFraction}" Maximum="1" />
                    <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Face inspector. Overlaid rather than a separate screen: checking a detection is
             something done in passing while looking at the grid, not a place to navigate to.

             The dimmed area behind the photograph dismisses the viewer when clicked, which is what
             everyone tries first. The photograph and the controls stop the click travelling that
             far, so pressing Next never closes the thing being read. -->
        <Border IsVisible="{Binding Overlay.IsVisible}" Background="#F2050810"
                PointerPressed="OnOverlayBackgroundPressed">
            <Grid RowDefinitions="Auto,*,Auto" Margin="32,22">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14"
                      PointerPressed="OnOverlayContentPressed">
                    <Button Grid.Column="0" Content="← Back" Command="{Binding CloseOverlayCommand}" />

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Overlay.Caption}" FontSize="13"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Overlay.Position}" Classes="muted" FontSize="11"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                               Text="Esc to close · ← → to move" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Content="‹" FontSize="26" Padding="16,6"
                            VerticalAlignment="Center" Margin="0,0,14,0"
                            Command="{Binding ShowPreviousCommand}"
                            PointerPressed="OnOverlayContentPressed"
                            ToolTip.Tip="Previous photo" />

                    <Grid Grid.Column="1" PointerPressed="OnOverlayContentPressed">
                        <Image Name="OverlayImage" Source="{Binding Overlay.Image}" Stretch="Uniform" />
                        <views:FaceOverlayControl Name="OverlayMarks" />
                    </Grid>

                    <Button Grid.Column="2" Content="›" FontSize="26" Padding="16,6"
                            VerticalAlignment="Center" Margin="14,0,0,0"
                            Command="{Binding ShowNextCommand}"
                            PointerPressed="OnOverlayContentPressed"
                            ToolTip.Tip="Next photo" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="18"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            PointerPressed="OnOverlayContentPressed">
                    <TextBlock Foreground="#FF6666" Text="● left eye" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Foreground="#66CCFF" Text="● right eye" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FFFF66" Text="● nose" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FF66FF" Text="● mouth left" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FFAA66" Text="● mouth right" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The one screen here that touches the user's own files, so it is built to be argued
             with: every member of a set is shown, the suggested keeper is only a preselection, and
             nothing moves until a folder has been chosen for it. -->
        <Border IsVisible="{Binding Duplicates.IsOpen}" Background="#F2050810">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32,26">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                    <Button Grid.Column="0" Content="← Back" VerticalAlignment="Center"
                            Margin="0,0,16,0" Command="{Binding Duplicates.CloseCommand}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DUPLICATE PHOTOS" Classes="heading" />
                        <TextBlock Classes="muted"
                                   Text="Sets of photos that are the same picture. The first in each set is the sharpest, and is kept." />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Classes="card" Padding="16" Margin="0,0,0,14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Find duplicates" Classes="primary"
                                    Command="{Binding Duplicates.FindCommand}" />
                            <Button Content="Stop" Classes="danger"
                                    Command="{Binding Duplicates.CancelCommand}"
                                    IsVisible="{Binding Duplicates.IsBusy}" />
                            <Border Width="1" Background="{StaticResource BorderSubtle}" Margin="6,2" />
                            <Button Content="Select every extra"
                                    Command="{Binding Duplicates.SelectAllExtrasCommand}" />
                            <Button Content="Clear selection"
                                    Command="{Binding Duplicates.ClearSelectionCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="MOVE TO" Classes="label" VerticalAlignment="Center" />
                            <Button Content="Choose folder…" Click="OnChooseQuarantineFolderClick" />
                            <TextBlock Classes="muted" VerticalAlignment="Center"
                                       MaxWidth="420" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Duplicates.HasQuarantineFolder}"
                                       Text="{Binding Duplicates.QuarantineFolder}" />
                            <TextBlock Classes="muted" VerticalAlignment="Center"
                                       IsVisible="{Binding !Duplicates.HasQuarantineFolder}"
                                       Text="Choose where the extras should go. They are moved, never deleted." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="primary"
                                    Content="{Binding Duplicates.SelectionCaption}"
                                    Command="{Binding Duplicates.MoveSelectedCommand}" />
                            <TextBlock Classes="muted" VerticalAlignment="Center"
                                       Text="The files are moved into that folder and dropped from the library. Delete them yourself once you are happy." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="card" Padding="40"
                        IsVisible="{Binding !Duplicates.Groups.Count}"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="⧉" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Accent}" />
                        <TextBlock Classes="muted" HorizontalAlignment="Center" MaxWidth="400"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Text="{Binding Duplicates.EmptyCaption}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding Duplicates.Groups.Count}">
                    <ItemsControl ItemsSource="{Binding Duplicates.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                                <Border Classes="card" Padding="14" Margin="0,0,0,12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding Caption}" Classes="label" />
                                        <ItemsControl ItemsSource="{Binding Members}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DuplicatePhotoViewModel">
                                                    <Border Classes="tile" Width="198" Padding="10"
                                                            Margin="0,0,12,0" Cursor="Hand"
                                                            AttachedToVisualTree="OnDuplicateAttached"
                                                            PointerPressed="OnDuplicatePressed"
                                                            ToolTip.Tip="{Binding FullPath}">
                                                        <StackPanel Spacing="8">
                                                            <Grid>
                                                                <Border Height="150" CornerRadius="8"
                                                                        ClipToBounds="True"
                                                                        Background="{StaticResource SurfaceDeep}">
                                                                    <Image Source="{Binding Thumbnail}"
                                                                           Stretch="UniformToFill" />
                                                                </Border>

                                                                <!-- Selected means "this one moves",
                                                                     which is the opposite of what a
                                                                     tick usually means on a grid of
                                                                     photos, so it is coloured as a
                                                                     warning rather than as a tick. -->
                                                                <Border IsVisible="{Binding IsSelected}"
                                                                        Background="#59FF5C7A"
                                                                        BorderThickness="2" CornerRadius="9"
                                                                        BorderBrush="{StaticResource Danger}" />
                                                                <Border IsVisible="{Binding IsKeeper}"
                                                                        VerticalAlignment="Top"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="6" Padding="7,2"
                                                                        CornerRadius="4"
                                                                        Background="{StaticResource AccentGradient}">
                                                                    <TextBlock Text="KEEP" FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="#05080F" />
                                                                </Border>
                                                                <TextBlock Text="MOVE" IsVisible="{Binding IsSelected}"
                                                                           VerticalAlignment="Top"
                                                                           HorizontalAlignment="Right"
                                                                           Margin="6" FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource Danger}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Dimensions}"
                                                                       Classes="muted" FontSize="10" />
                                                            <TextBlock Text="{Binding Size}"
                                                                       Classes="muted" FontSize="10" />
                                                            <TextBlock Text="{Binding Taken}"
                                                                       Classes="muted" FontSize="10" />
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Classes="muted" FontSize="10"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" Classes="card" Padding="16,12" Margin="0,14,0,0">
                    <StackPanel Spacing="8">
                        <ProgressBar IsVisible="{Binding Duplicates.IsBusy}"
                                     IsIndeterminate="{Binding Duplicates.IsProgressIndeterminate}"
                                     Value="{Binding Duplicates.ProgressFraction}" Maximum="1" />
                        <TextBlock Text="{Binding Duplicates.Status}" Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
