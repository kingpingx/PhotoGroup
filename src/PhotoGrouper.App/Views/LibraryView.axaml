<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoGrouper.App.ViewModels"
             xmlns:views="using:PhotoGrouper.App.Views"
             xmlns:photos="using:PhotoGrouper.Domain.Photos"
             xmlns:ports="using:PhotoGrouper.Application.Ports"
             x:Class="PhotoGrouper.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button Content="Add folder…" Click="OnAddFolderClick" />
                <Button Content="Scan" Command="{Binding ScanCommand}" />
                <Button Content="Detect faces" Command="{Binding DetectCommand}" />

                <ComboBox ItemsSource="{Binding Detectors}"
                          SelectedItem="{Binding SelectedDetector}"
                          MinWidth="150" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding SelectedDetector.Notes}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ports:ProviderInfo">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="Cancel" Command="{Binding CancelScanCommand}"
                        IsVisible="{Binding IsScanning}" />

                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="{Binding PhotoCount, StringFormat='{}{0:N0} photos'}"
                           Opacity="0.7" />
            </StackPanel>

            <!-- Scan roots -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ScanRoots}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="photos:ScanRoot">
                        <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center" />
                                <Button Content="✕" Padding="4,0" FontSize="11"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).RemoveScanRootCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Photo grid.

                 ItemsRepeater with a UniformGridLayout virtualises its containers, so only the
                 tiles actually on screen exist as controls. A WrapPanel would realise all of
                 them, which is fine for a hundred photos and fatal for fifty thousand. -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{Binding Photos}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="None"
                                           MinItemWidth="180" MinItemHeight="180"
                                           MinColumnSpacing="8" MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoTileViewModel">
                            <Border Width="180" Height="180" CornerRadius="4"
                                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                    ToolTip.Tip="{Binding Tooltip}"
                                    Cursor="Hand"
                                    PointerPressed="OnTilePressed"
                                    AttachedToVisualTree="OnTileAttached"
                                    DetachedFromVisualTree="OnTileDetached">
                                <Grid RowDefinitions="*,Auto">
                                    <Image Grid.Row="0" Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill" Margin="4" />
                                    <TextBlock Grid.Row="1" Text="{Binding FileName}"
                                               FontSize="11" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="6,0,6,6" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Status bar -->
            <StackPanel Grid.Row="3" Spacing="6" Margin="0,12,0,0">
                <ProgressBar IsVisible="{Binding IsScanning}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressFraction}" Maximum="1" Height="4" />
                <TextBlock Text="{Binding Status}" Opacity="0.75" FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Face inspector. Overlaid rather than a separate screen: checking a detection is
             something done in passing while looking at the grid, not a place to navigate to. -->
        <Border IsVisible="{Binding Overlay.IsVisible}"
                Background="#E6000000">
            <Grid RowDefinitions="Auto,*,Auto" Margin="24">
                <TextBlock Grid.Row="0" Text="{Binding Overlay.Caption}"
                           Foreground="White" FontSize="14" Margin="0,0,0,12" />

                <Grid Grid.Row="1">
                    <Image Name="OverlayImage" Source="{Binding Overlay.Image}" Stretch="Uniform" />
                    <views:FaceOverlayControl Name="OverlayMarks" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16"
                            HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Foreground="#FF6666" Text="● left eye" FontSize="11" />
                    <TextBlock Foreground="#66CCFF" Text="● right eye" FontSize="11" />
                    <TextBlock Foreground="#FFFF66" Text="● nose" FontSize="11" />
                    <TextBlock Foreground="#FF66FF" Text="● mouth left" FontSize="11" />
                    <TextBlock Foreground="#FFAA66" Text="● mouth right" FontSize="11" />
                    <Button Content="Close" Command="{Binding CloseOverlayCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
