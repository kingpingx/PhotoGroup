<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoGrouper.App.ViewModels"
             x:Class="PhotoGrouper.App.Views.PeopleView"
             x:DataType="vm:PeopleViewModel">

    <Grid>
    <Grid RowDefinitions="Auto,*,Auto" Margin="28,22">

        <Border Grid.Row="0" Classes="card" Padding="20,16" Margin="0,0,0,18">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="RECOGNISE AND GROUP" Classes="label" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Group faces into people" Classes="primary"
                                Command="{Binding GroupCommand}" />
                        <Button Content="Stop" Classes="danger" Command="{Binding CancelCommand}"
                                IsVisible="{Binding IsBusy}" />
                        <Button Classes="ghost" Command="{Binding RestoreIgnoredCommand}"
                                IsVisible="{Binding IgnoredFaceCount}"
                                Content="{Binding IgnoredFaceCount, StringFormat='Restore {0:N0} dismissed'}"
                                ToolTip.Tip="Bring dismissed faces back into grouping" />
                    </StackPanel>

                    <!-- Naming is what a user repeats most and what stands between a grouped
                         library and a useful one. A placeholder is not a real name, but it turns a
                         wall of anonymous groups into people who can be opened, merged and
                         renamed, and it makes the ones worth a real name obvious. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Name the rest automatically"
                                Command="{Binding AutoNameCommand}"
                                ToolTip.Tip="Give every group still waiting a numbered placeholder" />
                        <Button Content="Find duplicate people"
                                Command="{Binding DuplicatePeople.OpenCommand}"
                                IsEnabled="{Binding NamedPeopleCount}"
                                ToolTip.Tip="Compare everyone already named and find anybody named twice" />
                        <TextBox Text="{Binding DefaultNamePrefix}" Width="110" FontSize="12"
                                 Watermark="Person"
                                 ToolTip.Tip="The stem the numbers are added to" />
                        <TextBlock Classes="muted" VerticalAlignment="Center" FontSize="11"
                                   Text="numbered from 1, largest group first" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20"
                            VerticalAlignment="Center">
                    <!-- The material the other two counts are made of. Twelve people can hold
                         eighteen faces or forty, and the split between named and waiting is what
                         says how much of the library is actually done. -->
                    <StackPanel ToolTip.Tip="{Binding FaceCountBreakdown}">
                        <TextBlock Text="{Binding FaceCount, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Text="FACES" Classes="label" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel ToolTip.Tip="{Binding FaceCountBreakdown}">
                        <TextBlock Text="{Binding NamedFaceCount, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"
                                   Foreground="{StaticResource Success}" />
                        <TextBlock Text="FACES NAMED" Classes="label" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding NamedPeopleCount, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"
                                   Foreground="{StaticResource Success}" />
                        <TextBlock Text="PEOPLE" Classes="label" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding UnnamedGroupCount, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"
                                   Foreground="{StaticResource Accent}" />
                        <TextBlock Text="TO NAME" Classes="label" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="40"
                IsVisible="{Binding !HasGroups}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="◉" FontSize="34" HorizontalAlignment="Center"
                           Foreground="{StaticResource Accent}" />
                <TextBlock Text="Nobody grouped yet" Classes="heading" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" HorizontalAlignment="Center" MaxWidth="380"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Text="Find faces in the Library step first, then group them here. The recognition model is downloaded once, on the first run." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasGroups}">
            <StackPanel Spacing="22">

                <!-- Named people first: once somebody has a name, they are what the user came for. -->
                <StackPanel Spacing="10" IsVisible="{Binding NamedPeopleCount}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="PEOPLE" Classes="label"
                                   VerticalAlignment="Center" />
                        <!-- Tiles answer "who is this"; the table answers "who do I have, and how
                             much of each". Both carry the face, so the table loses nothing. -->
                        <ToggleButton Grid.Column="2" Classes="chip" IsChecked="{Binding IsTableView}"
                                      Margin="0,0,14,0" FontSize="11" Padding="10,5"
                                      Content="Table view"
                                      ToolTip.Tip="Show the people as rows with their counts" />
                        <TextBlock Grid.Column="3" Text="Sort by" Classes="muted"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="4" MinWidth="150"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding NamedPeople}" IsVisible="{Binding !IsTableView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonTileViewModel">
                                <Button Classes="ghost" Padding="0" Margin="0,0,12,12"
                                        Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).OpenPersonCommand}"
                                        CommandParameter="{Binding}"
                                        AttachedToVisualTree="OnPersonTileAttached"
                                        ToolTip.Tip="Open to rename, remove photos, or delete">
                                    <Border Classes="tile" Width="176" Padding="16">
                                        <StackPanel Spacing="10">
                                            <!-- The initial sits behind the face rather than beside
                                                 it, so a person whose crop has not loaded yet, or
                                                 whose photograph has gone missing, still shows
                                                 something identifiable instead of a grey square. -->
                                            <Border Width="144" Height="144" CornerRadius="10"
                                                    ClipToBounds="True" HorizontalAlignment="Left"
                                                    Background="{StaticResource AccentGradient}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" Foreground="#05080F"
                                                               FontSize="46" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Caption}" Classes="muted" FontSize="11"
                                                       HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The same people as rows. Column widths are repeated between the header and
                         the row template rather than shared, because a Grid's columns only align
                         within one Grid; the alternative is a full data grid control for four
                         columns that never change. -->
                    <StackPanel Spacing="2" IsVisible="{Binding IsTableView}"
                                MaxWidth="760" HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="56,*,110,110" Margin="12,0,12,6">
                            <TextBlock Grid.Column="1" Text="NAME" Classes="label" />
                            <TextBlock Grid.Column="2" Text="FACES" Classes="label"
                                       HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="PHOTOS" Classes="label"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding NamedPeople}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PersonTileViewModel">
                                    <Button Classes="ghost" Padding="0" Margin="0,0,0,4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).OpenPersonCommand}"
                                            CommandParameter="{Binding}"
                                            AttachedToVisualTree="OnPersonTileAttached"
                                            ToolTip.Tip="Open to rename, remove photos, or delete">
                                        <Border Classes="tile" Padding="12,8">
                                            <Grid ColumnDefinitions="56,*,110,110">
                                                <Border Grid.Column="0" Width="40" Height="40"
                                                        CornerRadius="8" ClipToBounds="True"
                                                        HorizontalAlignment="Left"
                                                        Background="{StaticResource AccentGradient}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}"
                                                                   Foreground="#05080F" FontSize="16"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="{Binding CoverImage}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding FaceCount}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding PhotoCount}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Naming a group is the core interaction of the application, so the box sits
                     directly on the tile rather than behind a dialog, and Enter completes it. -->
                <StackPanel Spacing="10" IsVisible="{Binding UnnamedGroupCount}">
                    <TextBlock Text="WHO ARE THESE?" Classes="label" />
                    <ItemsControl ItemsSource="{Binding UnnamedGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClusterTileViewModel">
                                <Border Classes="tile" Width="212" Margin="0,0,14,14" Padding="12"
                                        AttachedToVisualTree="OnGroupAttached">
                                    <StackPanel Spacing="10">
                                        <!-- The photograph for context, the cut-out face for the
                                             answer. A group shot produces one of these tiles per
                                             person in it, all showing the same picture; without the
                                             inset there is nothing to say which of them is being
                                             asked about. -->
                                        <Grid>
                                            <Border Height="158" CornerRadius="8" ClipToBounds="True"
                                                    Background="{StaticResource SurfaceDeep}">
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="62" Height="62" CornerRadius="8"
                                                    Margin="8" ClipToBounds="True"
                                                    BorderThickness="2"
                                                    BorderBrush="{StaticResource Accent}"
                                                    Background="{StaticResource SurfaceDeep}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    IsVisible="{Binding FaceCrop, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    ToolTip.Tip="The face this group is about">
                                                <Image Source="{Binding FaceCrop}" Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Caption}" Classes="muted" FontSize="11" />
                                        <TextBox Text="{Binding ProposedName}"
                                                 Watermark="Type a name, or press Enter"
                                                 KeyDown="OnNameKeyDown" />
                                        <Button Content="Name this person" Classes="primary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).NameCommand}"
                                                CommandParameter="{Binding}" />


                                        <!-- Grouping cannot always tell that two groups are one
                                             person. Choosing from the people already named avoids
                                             retyping a name and spelling it differently. -->
                                        <StackPanel Spacing="6" IsVisible="{Binding HasKnownPeople}">
                                            <ComboBox ItemsSource="{Binding KnownPeople}"
                                                      SelectedItem="{Binding SelectedPerson}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="or add to someone…"
                                                      FontSize="12">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PersonTileViewModel">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="Add to selected person"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" FontSize="11"
                                                    IsEnabled="{Binding SelectedPerson, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).AssignToExistingCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <!-- Most faces in a library are strangers. Without this the
                                             only way to clear a group off the screen is to invent a
                                             name for somebody nobody cares about. -->
                                        <Button Content="Not someone I care about" Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" FontSize="11"
                                                Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).IgnoreCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- People who appear exactly once. Kept apart from the groups above because a
                     single face has no corroboration, so these are the least certain and the most
                     likely to be strangers in the background. They used to be discarded entirely,
                     which on a small library silently hid a third of the faces. -->
                <StackPanel Spacing="10" IsVisible="{Binding SingleAppearanceCount}">
                    <TextBlock Text="{Binding SingleAppearanceCaption}" Classes="label" />
                    <ItemsControl ItemsSource="{Binding SingleAppearances}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClusterTileViewModel">
                                <Border Classes="tile" Width="176" Margin="0,0,12,12" Padding="10"
                                        AttachedToVisualTree="OnGroupAttached">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Border Height="122" CornerRadius="8" ClipToBounds="True"
                                                    Background="{StaticResource SurfaceDeep}">
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="52" Height="52" CornerRadius="8"
                                                    Margin="7" ClipToBounds="True"
                                                    BorderThickness="2"
                                                    BorderBrush="{StaticResource Accent}"
                                                    Background="{StaticResource SurfaceDeep}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    IsVisible="{Binding FaceCrop, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    ToolTip.Tip="The face this group is about">
                                                <Image Source="{Binding FaceCrop}" Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>
                                        <TextBox Text="{Binding ProposedName}"
                                                 Watermark="Type a name"
                                                 FontSize="12" KeyDown="OnNameKeyDown" />
                                        <!-- Enter alone was the only way to commit a name here,
                                             which is invisible unless somebody happens to try it.
                                             The larger tiles above always had the button. -->
                                        <Button Content="Name this person" Classes="primary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" FontSize="11"
                                                Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).NameCommand}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel Spacing="6" IsVisible="{Binding HasKnownPeople}">
                                            <ComboBox ItemsSource="{Binding KnownPeople}"
                                                      SelectedItem="{Binding SelectedPerson}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="or add to someone…"
                                                      FontSize="12">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PersonTileViewModel">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="Add to selected person"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" FontSize="11"
                                                    IsEnabled="{Binding SelectedPerson, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).AssignToExistingCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <Button Content="Not someone I care about" Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" FontSize="11"
                                                Command="{Binding $parent[ItemsControl].((vm:PeopleViewModel)DataContext).IgnoreCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="card" Padding="16,12" Margin="0,16,0,0">
            <StackPanel Spacing="8">
                <ProgressBar IsVisible="{Binding IsBusy}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressFraction}" Maximum="1" />
                <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Correction panel for one person. Overlaid rather than made a separate step, because fixing
         a grouping is done while looking at the people, not somewhere to navigate to. -->
    <Border IsVisible="{Binding Detail.IsOpen}" Background="#F2050810"
            PointerPressed="OnDetailBackgroundPressed">
        <!-- Transparent rather than unset: a panel with no background is not hit-testable at all,
             so clicks in the gaps between photographs would fall straight through to the dimmed
             area behind and close the panel somebody was working in. -->
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32,26"
              Background="Transparent"
              PointerPressed="OnDetailContentPressed">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                <Button Grid.Column="0" Content="← Back" Command="{Binding Detail.CloseCommand}"
                        VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Detail.PersonName}" Classes="heading" />
                    <TextBlock Text="{Binding Detail.SelectionCaption}" Classes="muted" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                           Text="Esc to go back" />
            </Grid>

            <Border Grid.Row="1" Classes="card" Padding="16" Margin="0,0,0,14">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="NAME" Classes="label" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Detail.EditedName}" Watermark="Person's name"
                                 MinWidth="240" />
                        <Button Content="Rename" Command="{Binding Detail.RenameCommand}" />
                        <Border Width="1" Background="{StaticResource BorderSubtle}" Margin="8,2" />
                        <Button Content="Select all" Command="{Binding Detail.SelectAllCommand}" />
                        <Button Content="Clear selection" Command="{Binding Detail.ClearSelectionCommand}" />
                        <Button Classes="danger" Content="{Binding Detail.SelectionCaption}"
                                Command="{Binding Detail.RemoveSelectedCommand}" />
                    </StackPanel>

                    <!-- A burst leaves several frames of one instant on a person, all genuinely
                         them, so nothing else here has any reason to separate them. This marks the
                         sets on the tiles already on screen and selects the extras, leaving the
                         remove button above to be what actually acts. -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="TIDY" Classes="label" VerticalAlignment="Center" />
                        <Button Content="Find near-identical"
                                Command="{Binding Detail.FindDuplicatesCommand}"
                                ToolTip.Tip="Mark faces of this person that are the same moment, such as frames of one burst" />
                        <TextBlock Classes="muted" VerticalAlignment="Center"
                                   IsVisible="{Binding Detail.HasDuplicateSummary}"
                                   Text="{Binding Detail.DuplicateSummary}" />
                        <TextBlock Classes="muted" VerticalAlignment="Center"
                                   IsVisible="{Binding !Detail.HasDuplicateSummary}"
                                   Text="Marks the sets and selects the extras. The photos stay in the library." />
                    </StackPanel>

                    <!-- Moving is the correction for a face grouping put on the wrong person, as
                         opposed to one who is nobody in this library. Removing only detaches it and
                         leaves it to be grouped again; moving says where it actually belongs. -->
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                IsVisible="{Binding Detail.HasOtherPeople}">
                        <TextBlock Text="MOVE TO" Classes="label" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Detail.OtherPeople}"
                                  SelectedItem="{Binding Detail.MoveTarget}"
                                  PlaceholderText="another person…" MinWidth="200" />
                        <Button Content="Move selected"
                                Command="{Binding Detail.MoveSelectedCommand}" />
                        <TextBlock Classes="muted" VerticalAlignment="Center"
                                   Text="Select photos above, then choose who they really are." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                IsVisible="{Binding !Detail.IsConfirmingDelete}">
                        <Button Content="Remove this person" Classes="danger"
                                Command="{Binding Detail.BeginDeleteCommand}" />
                        <TextBlock Classes="muted" VerticalAlignment="Center"
                                   Text="Their photos stay in the library and can be named again." />
                    </StackPanel>

                    <Border IsVisible="{Binding Detail.IsConfirmingDelete}"
                            CornerRadius="8" Padding="14" Background="#33FF5C7A">
                        <StackPanel Spacing="10">
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="Remove this person? The name is deleted; the photos and faces are kept, and their group becomes available to name again." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Yes, remove" Classes="danger"
                                        Command="{Binding Detail.ConfirmDeleteCommand}" />
                                <Button Content="Cancel" Command="{Binding Detail.CancelDeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{Binding Detail.Photos}"
                               ElementPrepared="OnPersonPhotoPrepared">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="None"
                                           MinItemWidth="168" MinItemHeight="168"
                                           MinColumnSpacing="10" MinRowSpacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonPhotoViewModel">
                            <Border Width="168" Height="168" Classes="tile" Cursor="Hand"
                                    ClipToBounds="True" PointerPressed="OnPersonPhotoPressed"
                                    ToolTip.Tip="{Binding FileName}">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Margin="5" />

                                    <!-- Which face of this photograph belongs to this person. The
                                         same picture can appear twice in one person's grid, and
                                         removing the right one is impossible without seeing them. -->
                                    <Border Width="52" Height="52" CornerRadius="8" Margin="9"
                                            ClipToBounds="True" BorderThickness="2"
                                            BorderBrush="{StaticResource Accent}"
                                            Background="{StaticResource SurfaceDeep}"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            IsVisible="{Binding FaceCrop, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Source="{Binding FaceCrop}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Selection is a tinted overlay with a tick rather than a
                                         checkbox in a corner, so it stays legible over a
                                         photograph of any brightness. -->
                                    <Border IsVisible="{Binding IsSelected}"
                                            Background="#5900D9FF" BorderThickness="2"
                                            BorderBrush="{StaticResource Accent}" CornerRadius="9" />
                                    <TextBlock Text="&#x2713;" IsVisible="{Binding IsSelected}"
                                               FontSize="34" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Which set this belongs to, and how alike it is. Both sit
                                         above the selection tint, because the tint is what says a
                                         photograph is about to be removed and these are what
                                         justify it. -->
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="6" Spacing="3"
                                                IsVisible="{Binding IsInDuplicateSet}">
                                        <Border Padding="6,2" CornerRadius="4"
                                                HorizontalAlignment="Right"
                                                Background="#CC0B1220">
                                            <TextBlock Text="{Binding DuplicateBadge}" FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="4"
                                                HorizontalAlignment="Right"
                                                Background="{StaticResource AccentGradient}"
                                                IsVisible="{Binding IsDuplicateKeeper}">
                                            <TextBlock Text="KEEP" FontSize="9" FontWeight="Bold"
                                                       Foreground="#05080F" />
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="4"
                                                HorizontalAlignment="Right"
                                                Background="#CC0B1220">
                                            <TextBlock Text="{Binding MatchCaption}" FontSize="9"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="{Binding Detail.Status}"
                       Foreground="{StaticResource Accent}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,14,0,0" />
        </Grid>
    </Border>

    <!-- Names that look like one person. Merging destroys a name, so each set is decided on its
         own, with the face shown large enough to judge by: the question is whether two faces are
         the same person, and no name can answer that. -->
    <Border IsVisible="{Binding DuplicatePeople.IsOpen}" Background="#F2050810">
        <Grid RowDefinitions="Auto,*,Auto" Margin="32,26">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                <Button Grid.Column="0" Content="← Back" VerticalAlignment="Center"
                        Margin="0,0,16,0" Command="{Binding DuplicatePeople.CloseCommand}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="NAMED TWICE" Classes="heading" />
                    <TextBlock Classes="muted"
                               Text="Sets of names whose faces look like one person. Click a face to choose which name survives." />
                </StackPanel>
                <Button Grid.Column="2" Content="Look again"
                        Command="{Binding DuplicatePeople.FindCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Classes="card" Padding="40"
                    IsVisible="{Binding !DuplicatePeople.Groups.Count}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="⧉" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Classes="muted" HorizontalAlignment="Center" MaxWidth="400"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="{Binding DuplicatePeople.EmptyCaption}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding DuplicatePeople.Groups.Count}">
                <ItemsControl ItemsSource="{Binding DuplicatePeople.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DuplicatePersonGroupViewModel">
                            <Border Classes="card" Padding="14" Margin="0,0,0,12">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Caption}"
                                                   Classes="label" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Classes="primary"
                                                Content="{Binding Action}"
                                                Command="{Binding $parent[ItemsControl].((vm:DuplicatePeopleViewModel)DataContext).MergeCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Members}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DuplicatePersonViewModel">
                                                <Button Classes="ghost" Padding="0" Margin="0,0,12,0"
                                                        AttachedToVisualTree="OnDuplicatePersonAttached"
                                                        Command="{Binding $parent[ItemsControl].((vm:DuplicatePeopleViewModel)DataContext).ChooseKeeperCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Keep this name and merge the others into it">
                                                    <Border Classes="tile" Width="168" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <Grid>
                                                                <Border Width="148" Height="148"
                                                                        CornerRadius="10" ClipToBounds="True"
                                                                        Background="{StaticResource AccentGradient}">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Initial}"
                                                                                   Foreground="#05080F"
                                                                                   FontSize="46" FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                        <Image Source="{Binding Face}"
                                                                               Stretch="UniformToFill" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border IsVisible="{Binding IsKeeper}"
                                                                        BorderThickness="3" CornerRadius="11"
                                                                        BorderBrush="{StaticResource Accent}" />
                                                                <Border IsVisible="{Binding IsKeeper}"
                                                                        VerticalAlignment="Top"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="6" Padding="7,2" CornerRadius="4"
                                                                        Background="{StaticResource AccentGradient}">
                                                                    <TextBlock Text="KEEP" FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="#05080F" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Caption}"
                                                                       Classes="muted" FontSize="10" />
                                                            <TextBlock Text="{Binding Match}"
                                                                       Foreground="{StaticResource Accent}"
                                                                       FontSize="10" />
                                                        </StackPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Classes="card" Padding="16,12" Margin="0,14,0,0">
                <TextBlock Text="{Binding DuplicatePeople.Status}" Classes="muted"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
    </Grid>
</UserControl>
