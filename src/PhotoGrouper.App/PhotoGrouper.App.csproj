<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- The manifest declares long-path awareness, which is a Windows concept. Applying it elsewhere
       is at best ignored and at worst a build error. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
  </PropertyGroup>

  <!-- The manifest asks Windows for long-path support and DPI awareness. It has no meaning on
       other platforms and referencing it there fails the build. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoGrouper.Domain\PhotoGrouper.Domain.csproj" />
    <ProjectReference Include="..\PhotoGrouper.Application\PhotoGrouper.Application.csproj" />
    <ProjectReference Include="..\PhotoGrouper.Infrastructure.Storage.Sqlite\PhotoGrouper.Infrastructure.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\PhotoGrouper.Infrastructure.FileSystem\PhotoGrouper.Infrastructure.FileSystem.csproj" />
    <ProjectReference Include="..\PhotoGrouper.Infrastructure.Vision\PhotoGrouper.Infrastructure.Vision.csproj" />
    <ProjectReference Include="..\PhotoGrouper.Infrastructure.Imaging\PhotoGrouper.Infrastructure.Imaging.csproj" />
  </ItemGroup>

</Project>
