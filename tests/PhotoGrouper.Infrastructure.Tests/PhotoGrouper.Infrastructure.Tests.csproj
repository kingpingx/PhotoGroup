  <ItemGroup>
    <ProjectReference Include="..\..\src\PhotoGrouper.Domain\PhotoGrouper.Domain.csproj" />
    <ProjectReference Include="..\..\src\PhotoGrouper.Application\PhotoGrouper.Application.csproj" />
    <ProjectReference Include="..\..\src\PhotoGrouper.Infrastructure.Storage.Sqlite\PhotoGrouper.Infrastructure.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\PhotoGrouper.Infrastructure.FileSystem\PhotoGrouper.Infrastructure.FileSystem.csproj" />
    <ProjectReference Include="..\PhotoGrouper.Contracts.Tests\PhotoGrouper.Contracts.Tests.csproj" />
    <ProjectReference Include="..\..\src\PhotoGrouper.Infrastructure.Vision\PhotoGrouper.Infrastructure.Vision.csproj" />
